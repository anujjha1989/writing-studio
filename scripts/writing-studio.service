[Unit]
Description=Writing Studio
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__/current
Environment=PORT=__PORT__
Environment=NS_DATA_DIR=__APP_DIR__/data
ExecStart=__NODE__ --disable-warning=ExperimentalWarning server/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
